FROM python:3.9-slim

# Install Java runtime (default-jre-headless) and procps for PySpark
RUN apt-get update && \
    apt-get install -y --no-install-recommends default-jre-headless procps curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install PySpark, psycopg2-binary, and kafka-python-ng
RUN pip install --no-cache-dir pyspark==3.5.3 psycopg2-binary==2.9.10 kafka-python-ng findspark

# Pre-fetch Spark Kafka connector & PostgreSQL JDBC driver during image build
# so the container runs 100% offline without needing internet to download jars!
RUN python3 -c "\
from pyspark.sql import SparkSession; \
spark = SparkSession.builder.master('local[1]') \
    .config('spark.jars.packages', 'org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.3,org.postgresql:postgresql:42.6.0') \
    .getOrCreate(); \
spark.stop()"

# Copy consumer application code and config
COPY spark_streaming.py config.ini ./

ENV PYTHONUNBUFFERED=1
ENV KAFKA_BOOTSTRAP_SERVERS=kafka:29092
ENV KAFKA_TOPIC=retail_stream
ENV POSTGRES_HOST=postgres
ENV POSTGRES_PORT=5432
ENV POSTGRES_DB=retail_db
ENV POSTGRES_USER=postgres
ENV POSTGRES_PASSWORD=postgrespassword
ENV POSTGRES_TABLE=retail_transactions
ENV CHECKPOINT_DIR=temp/checkpoints/docker_stream

CMD ["python3", "spark_streaming.py"]
