# ==============================================================================
# Port Configuration & Environment Variables Template
# Copy file ini ke .env jika ingin mengubah port yang bentrok
# ==============================================================================

# Port PostgreSQL di Host (Default: 5432. Ganti ke 5433 atau 5416 jika port 5432 bentrok)
POSTGRES_PORT=5432

# Port pgAdmin di Host (Default: 5050. Ganti ke 5051 jika bentrok)
PGADMIN_PORT=5050

# Port Kafka di Host (Default: 9092)
KAFKA_PORT=9092

# Port Zookeeper di Host (Default: 2181)
ZOOKEEPER_PORT=2181

# Kredensial PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=retail_db

# Kredensial pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
